# ─────────────────────────────────────────────────────────────────────────────
# Exam Verification System — environment variables
# Copy this file to .env and fill in real values. Never commit .env.
# In Docker: docker-compose overrides DB_HOST=postgres and NODE_ENV=production.
# ─────────────────────────────────────────────────────────────────────────────

# Application
NODE_ENV=development
PORT=3000

# Database
# In Docker the host is the postgres service name; set DB_HOST=postgres there.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=change_me
DB_DATABASE=exam_verification
# MUST be false in production — use migrations instead.
DB_SYNCHRONIZE=false

# JWT — secret must be at least 32 random characters
JWT_SECRET=change_me_to_a_secure_random_string_at_least_32_chars
JWT_EXPIRES_IN=1d

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Rate limiting — TTL in seconds, max requests per TTL window
THROTTLE_TTL=60
THROTTLE_LIMIT=120
